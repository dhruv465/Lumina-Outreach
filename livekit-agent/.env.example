LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_OUTBOUND_TRUNK_ID=ST_xxxx
# Provider keys (Deepgram/LLM) are BYO per user — configured in the app, delivered per call.
LUMINA_API_URL=http://localhost:8000/api
LUMINA_SERVICE_API_KEY=
# Krisp BVCTelephony barge-in noise cancellation (LiveKit Cloud only).
# Set to false on self-hosted deploys.
LIVEKIT_BVC_ENABLED=true
# Hang-up guards. These bound what a call costs when the LLM never calls
# end_call: seconds of silence before the agent asks "are you still there?",
# how many times it asks, how long it waits for each answer, and the hard
# ceiling on one conversation measured from pickup.
USER_AWAY_TIMEOUT=10
INACTIVITY_CHECKINS=2
INACTIVITY_CHECKIN_INTERVAL=8
MAX_CALL_SECONDS=600
