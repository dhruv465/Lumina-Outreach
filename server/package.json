{
  "name": "lumina-outreach-server",
  "version": "1.0.0",
  "description": "Backend server for Lumina Outreach intelligent communication system",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=1536 --optimize-for-size --expose-gc dist/index.js",
    "start:prod": "NODE_ENV=production node --max-old-space-size=1536 --optimize-for-size --expose-gc dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules -- src/index.ts",
    "dev:debug": "ts-node-dev --respawn --transpile-only --inspect=0.0.0.0:9229 src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prestart": "npm run build",
    "prestart:prod": "npm run build",
    "docker:build": "docker build -t lumina-outreach-server .",
    "docker:run": "docker run -p 8000:8000 lumina-outreach-server",
    "logs:clear": "rm -f logs/*.log logs/server_log_lumina.txt",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "memory:monitor": "node --expose-gc --max-old-space-size=1536 --optimize-for-size dist/index.js",
    "migrate:deepgram": "ts-node src/migrations/deepgram-config-migration.ts migrate",
    "migrate:deepgram:rollback": "ts-node src/migrations/deepgram-config-migration.ts rollback",
    "test:deepgram": "node quick-deepgram-test.js",
    "test:deepgram-web": "node test-deepgram-web.js",
    "migrate:deepgram:validate": "ts-node src/migrations/deepgram-config-migration.ts validate",
    "migrate:deepgram:compatibility": "ts-node src/migrations/deepgram-model-compatibility-migration.ts migrate",
    "migrate:deepgram:compatibility:rollback": "ts-node src/migrations/deepgram-model-compatibility-migration.ts rollback",
    "migrate:deepgram:compatibility:report": "ts-node src/migrations/deepgram-model-compatibility-migration.ts report",
    "migrate:deepgram:compatibility:check": "ts-node src/migrations/deepgram-model-compatibility-migration.ts compatibility",
    "analyze:unused": "ts-node scripts/find-unused-files.ts",
    "cleanup:unused": "bash scripts/delete-unused-files.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^1.20.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.42.0",
    "@sentry/profiling-node": "^10.42.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/cron": "^2.0.1",
    "@types/redis": "^4.0.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "async-retry": "^1.3.3",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cron": "^4.3.3",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "googleapis": "^171.4.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.17",
    "livekit-server-sdk": "^2.16.0",
    "mammoth": "^1.11.0",
    "mongoose": "^8.18.1",
    "node-cache": "^5.1.2",
    "openai": "^5.20.3",
    "opossum": "^5.0.1",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^7.3.1",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.7.5",
    "streamifier": "^0.1.1",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/connect": "^3.4.38",
    "@types/dotenv": "^6.1.1",
    "@types/form-data": "^2.2.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^24.5.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/socket.io": "^3.0.1",
    "@types/validator": "^13.15.3",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "form-data": "^4.0.4",
    "jest": "^29.5.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4"
  }
}
